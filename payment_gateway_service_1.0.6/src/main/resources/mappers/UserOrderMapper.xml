<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper
	namespace="com.treasurex.payment_gateway.Mapper.UserOrdersMapper">

	<!-- Result Map -->
	<resultMap id="UserOrdersResultMap"
		type="com.treasurex.payment_gateway.model.UserOrders">
		<id property="id" column="id" />
		<result property="email" column="email" />
		<result property="subscriptionType" column="subscription_type" />
		<result property="amount" column="amount" />
		<result property="orderStatus" column="order_status" />
		<result property="razorpayOrderId" column="razorpay_order_id" />
	</resultMap>

	<!-- Find by Razorpay Order ID -->
	<select id="findByRazorpayOrderId" parameterType="string"
		resultMap="UserOrdersResultMap">
		SELECT *
		FROM user_orders
		WHERE razorpay_order_id = #{razorpayOrderId}
	</select>

	<!-- Find by Email -->
	<select id="findByEmail" parameterType="string"
		resultMap="UserOrdersResultMap">
		SELECT *
		FROM user_orders
		WHERE email = #{email}
	</select>

	<!-- Insert -->
	<insert id="save"
		parameterType="com.treasurex.payment_gateway.model.UserOrders"
		useGeneratedKeys="true" keyProperty="id">
		INSERT INTO user_orders (
		email,
		subscription_type,
		amount,
		order_status,
		razorpay_order_id
		) VALUES (
		#{email},
		#{subscriptionType},
		#{amount},
		#{orderStatus},
		#{razorpayOrderId}
		)
	</insert>

	<!-- Update -->
	<update id="update"
		parameterType="com.treasurex.payment_gateway.model.UserOrders">
		UPDATE user_orders
		SET order_status = #{orderStatus}
		WHERE razorpay_order_id = #{razorpayOrderId}
	</update>

</mapper>
